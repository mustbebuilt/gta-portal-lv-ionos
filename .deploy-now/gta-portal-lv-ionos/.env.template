APP_NAME="GTA Local Test"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=$IONOS_APP_URL
APP_LOCALE=en_GB
#DB_CONNECTION=mysql
SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=smtp
LOG_CHANNEL=single
LOG_LEVEL=warning

GTA_PRIVATE_EVIDENCE_DISK=local
GTA_LEGACY_EVIDENCE_DISK=local
GTA_PRIVATE_EVIDENCE_ALLOWED_DISKS=local

GTA_PASSWORD_RECOVERY_ENABLED=false

# Opt-in daily IN-PORTAL prompt generation only; requires scheduler infrastructure.
GTA_SCHEDULE_PORTAL_REMINDERS=false

# Hosted staging is explicitly opt-in; production remains blocked.
GTA_ENABLE_STAGING_PORTAL=false
GTA_ALLOW_INITIAL_ADMIN=false

# Staging evidence copies only; does not activate new storage or relink records.
GTA_ENABLE_EVIDENCE_COPY=false

# Controlled recovery SMTP pilot: staging only; remains off until deliberately configured.
GTA_STAGING_PASSWORD_RECOVERY_ENABLED=false
GTA_STAGING_RECOVERY_RECIPIENTS=
MAIL_TIMEOUT=10

# Separate controlled staging account onboarding; never enable for real users here.
GTA_STAGING_ONBOARDING_ENABLED=false
GTA_STAGING_ONBOARDING_RECIPIENTS=

# Explicit, reviewed staging reminder mail only; no automatic scheduler dispatch.
GTA_STAGING_REMINDER_MAIL_ENABLED=false
GTA_STAGING_REMINDER_MAIL_RECIPIENTS=

# Separate private, non-cutover recovery rehearsal. Configure a dedicated private target first.
GTA_ENABLE_EVIDENCE_RESTORE_REHEARSAL=false
GTA_EVIDENCE_RESTORE_TARGET_DISKS=

# Pack 08: shared external questionnaires. Leave disabled until exact responder URLs are reviewed.
GTA_QUESTIONNAIRES_ENABLED=false
GTA_QUESTIONNAIRE_HOSTS=
GTA_QUESTIONNAIRE_INDUCTION_URL=
GTA_QUESTIONNAIRE_INDUCTION_REVIEWED_SHA256=
GTA_QUESTIONNAIRE_SIXWEEK_URL=
GTA_QUESTIONNAIRE_SIXWEEK_REVIEWED_SHA256=
GTA_QUESTIONNAIRE_ONGOING_URL=
GTA_QUESTIONNAIRE_ONGOING_REVIEWED_SHA256=

# Pack 09: optional staff MFA staging pilot. OFF affects new enrolment, not confirmed accounts.
GTA_MFA_ENROLMENT_ENABLED=false
GTA_MFA_PILOT_EMAILS=

# Pack 11: independent opt-in scheduler; in-portal support-plan prompts only (no email).
GTA_SCHEDULE_SUPPORT_PLAN_REMINDERS=false

# Apprentice mobile verification only; not automatic task/review reminders.
GTA_SMS_MOBILE_VERIFICATION_ENABLED=false
GTA_SMS_MOBILE_VERIFICATION_RECIPIENTS=
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SMS_FROM=

# Pack24 apprentice operational reminders; all sending/scheduling OFF by default.
GTA_APPRENTICE_ALERTS_ENABLED=false
GTA_APPRENTICE_ALERTS_SCHEDULED=false
GTA_APPRENTICE_ALERT_EMAIL_ENABLED=false
GTA_APPRENTICE_ALERT_SMS_ENABLED=false
GTA_APPRENTICE_ALERT_EMAIL_RECIPIENTS=
GTA_APPRENTICE_ALERT_SMS_RECIPIENTS=
GTA_APPRENTICE_ALERT_MAX_ATTEMPTS_24H=50

# Set only after GTA confirms a suitable inter-centre travel minimum (5–180 minutes).
GTA_PLANNING_CROSS_SITE_MINUTES=
